rules_version = '2';

// Firestore security rules for Dowell Pest Control.
//
// Model: each Firestore document is owned by a user identified by a `customerId`
// (referrals), `employeeId` (employee_tasks / employee_cashouts), or `userId`
// (bugbucks_transactions / cash_bonus_transactions / role_requests /
// notifications). The `users/{uid}` profile is keyed by document id.
//
// Pattern: owners receive only the narrow reads/profile operations listed below.
// Trusted Functions use the Admin SDK; claimed admins retain explicit management
// access. Reads/writes that don't match an allow rule are denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ─────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function isActiveProfile(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status != 'deleted'
        && (!get(/databases/$(database)/documents/users/$(uid)).data.keys()
          .hasAny(['isDeleted'])
          || get(/databases/$(database)/documents/users/$(uid)).data.isDeleted == false);
    }

    function doesNotChangeDeletionMetadata() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isDeleted', 'deletedAt', 'deletedBy', 'deletedSource',
        'deletionReason', 'ownerAccountDeleted', 'accountDeletionStatus'
      ]);
    }

    function hasNoDeletionMetadata() {
      return !request.resource.data.keys().hasAny([
        'deletedAt', 'deletedBy', 'deletedSource', 'deletionReason',
        'ownerAccountDeleted', 'accountDeletionStatus'
      ]) && (!request.resource.data.keys().hasAny(['isDeleted'])
        || request.resource.data.isDeleted == false);
    }

    // Balances and review/payment state change only in trusted Functions
    // (admin-finance.ts), inside one transaction with a ledger entry.
    function doesNotChangeBalances() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'bugBucks', 'cashBonusBalance', 'walletBalance', 'cashBalance'
      ]);
    }

    // Derived counters are maintained only by trusted Functions, in the same
    // transaction as the task/referral change they count.
    function doesNotChangeCounters() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'pendingTasks', 'totalTasks', 'approvedTasks', 'totalReferrals', 'convertedReferrals'
      ]);
    }

    function createsNoCounters() {
      return (!request.resource.data.keys().hasAny(['pendingTasks']) || request.resource.data.pendingTasks == 0)
        && (!request.resource.data.keys().hasAny(['totalTasks']) || request.resource.data.totalTasks == 0)
        && (!request.resource.data.keys().hasAny(['approvedTasks']) || request.resource.data.approvedTasks == 0)
        && (!request.resource.data.keys().hasAny(['totalReferrals']) || request.resource.data.totalReferrals == 0)
        && (!request.resource.data.keys().hasAny(['convertedReferrals']) || request.resource.data.convertedReferrals == 0);
    }

    function createsNoBalance() {
      return (!request.resource.data.keys().hasAny(['bugBucks'])
          || request.resource.data.bugBucks == 0)
        && (!request.resource.data.keys().hasAny(['cashBonusBalance'])
          || request.resource.data.cashBonusBalance == 0)
        && !request.resource.data.keys().hasAny(['walletBalance', 'cashBalance']);
    }

    function doesNotChangeTaskReview() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status', 'cashBonusAwarded', 'paidOut', 'isPaid', 'bonusCreditedToBalance',
        'approvedBy', 'approvedAt', 'rejectedBy', 'rejectedAt', 'reviewedBy',
        'reviewedAt', 'cashBonusTransactionId', 'settlementStatus', 'settledAt',
        'settledBy', 'employeeId'
      ]);
    }

    // Approved policy: numeric, finite, 0 < bonus <= 1000, whole cents. The
    // cent check mirrors the server exactly: round(x * 100) / 100 == x.
    function isValidTaskBonus(value) {
      return value is number
        && value > 0
        && value <= 1000
        && float(math.round(float(value) * 100.0)) / 100.0 == float(value);
    }

    // Owners may only mark their own notification read or dismissed.
    function isNotificationReadUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read', 'isRead', 'readAt', 'dismissed', 'dismissedAt'
        ])
        && (!request.resource.data.keys().hasAny(['read']) || request.resource.data.read is bool)
        && (!request.resource.data.keys().hasAny(['isRead']) || request.resource.data.isRead is bool)
        && (!request.resource.data.keys().hasAny(['dismissed']) || request.resource.data.dismissed is bool)
        && (!request.resource.data.keys().hasAny(['readAt']) || request.resource.data.readAt is timestamp)
        && (!request.resource.data.keys().hasAny(['dismissedAt']) || request.resource.data.dismissedAt is timestamp);
    }

    function resourceIsActive() {
      return !resource.data.keys().hasAny(['isDeleted'])
        || resource.data.isDeleted == false;
    }

    function hasOnlyCustomerProfileDefaults() {
      return request.resource.data.keys().hasAll([
          'email', 'role', 'status', 'needsVerification', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'name', 'phone', 'address', 'photoURL',
          'role', 'status', 'needsVerification', 'createdAt', 'updatedAt',
          'bugBucks', 'cashBonusBalance', 'totalReferrals',
          'convertedReferrals', 'totalTasks', 'pendingTasks'
        ])
        && request.resource.data.role == 'customer'
        && request.resource.data.status == 'active'
        && request.resource.data.needsVerification == false
        && (!request.resource.data.keys().hasAny(['bugBucks'])
          || request.resource.data.bugBucks == 0)
        && (!request.resource.data.keys().hasAny(['cashBonusBalance'])
          || request.resource.data.cashBonusBalance == 0)
        && (!request.resource.data.keys().hasAny(['totalReferrals'])
          || request.resource.data.totalReferrals == 0)
        && (!request.resource.data.keys().hasAny(['convertedReferrals'])
          || request.resource.data.convertedReferrals == 0)
        && (!request.resource.data.keys().hasAny(['totalTasks'])
          || request.resource.data.totalTasks == 0)
        && (!request.resource.data.keys().hasAny(['pendingTasks'])
          || request.resource.data.pendingTasks == 0);
    }

    function isProfileOnlyUpdate() {
      return resource.data.status != 'deleted'
        && (!resource.data.keys().hasAny(['isDeleted'])
          || resource.data.isDeleted == false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName', 'name', 'email', 'phone', 'address', 'photoURL',
        'updatedAt'
      ]);
    }

    function isValidRoleRequestTransition() {
      return resource.data.keys().hasAll(['role', 'status', 'needsVerification'])
          && request.resource.data.keys().hasAll([
            'role', 'status', 'needsVerification', 'requestedRole'
          ])
        ? resource.data.role == 'customer'
          && resource.data.status == 'active'
          && resource.data.needsVerification == false
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == 'pending'
          && request.resource.data.needsVerification == true
          && request.resource.data.requestedRole == 'employee'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'needsVerification', 'requestedRole', 'status', 'updatedAt'
          ])
        : false;
    }

    // ─── users/{uid} ────────────────────────────────────────────────────
    // Owners can maintain ordinary profile fields and initiate the one supported
    // role-request transition. Authorization, rewards, counters, and review
    // metadata are trusted-server/admin-claim fields.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if false;
      allow create: if (isAdmin() && hasNoDeletionMetadata() && createsNoBalance() && createsNoCounters())
        || (isOwner(uid) && hasOnlyCustomerProfileDefaults());
      allow update: if (isAdmin() && resourceIsActive()
          && doesNotChangeDeletionMetadata() && doesNotChangeBalances() && doesNotChangeCounters())
        || (isOwner(uid) && (isProfileOnlyUpdate() || isValidRoleRequestTransition()));
    }

    // ─── referrals/{id} ─────────────────────────────────────────────────
    // The callable backend is the sole referral creation/reward path.
    // Customers can read their own legacy and callable-created records;
    // claimed admins retain the existing approval/conversion workflow.
    match /referrals/{id} {
      allow read: if (isOwner(resource.data.customerId)
          && isActiveProfile(request.auth.uid)) || isAdmin();
      allow create: if isAdmin() && hasNoDeletionMetadata();
      allow update: if isAdmin() && resourceIsActive()
        && doesNotChangeDeletionMetadata();
      allow delete: if false;
    }

    // ─── employee_tasks/{id} ────────────────────────────────────────────
    // The callable is the sole employee task creation path.
    // Review (approve/reject) and bonus credit go through reviewEmployeeTask.
    match /employee_tasks/{id} {
      allow read: if (isOwner(resource.data.employeeId)
          && isActiveProfile(request.auth.uid)) || isAdmin();
      allow create: if isAdmin() && hasNoDeletionMetadata();
      allow update: if isAdmin() && resourceIsActive()
        && doesNotChangeDeletionMetadata() && doesNotChangeTaskReview();
      allow delete: if false;
    }

    // ─── employee_cashouts/{id} ─────────────────────────────────────────
    // Legacy financial records. The current app has no cashout workflow, so no
    // client (admins included) may create or change them; only trusted
    // backend code (account deletion soft-delete) writes here.
    match /employee_cashouts/{id} {
      allow read: if isOwner(resource.data.employeeId) || isAdmin();
      allow create, update: if false;
      allow delete: if false;
    }

    // ─── bugbucks_transactions/{id} ─────────────────────────────────────
    // Reward ledger entries are written only by trusted Functions.
    match /bugbucks_transactions/{id} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── cash_bonus_transactions/{id} ───────────────────────────────────
    // Written only by trusted Functions (task review, adjustments, settlement).
    match /cash_bonus_transactions/{id} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── role_requests/{id} ─────────────────────────────────────────────
    // User creates a request for themselves; admin approves/rejects.
    match /role_requests/{id} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if false;
      allow create: if isOwner(request.resource.data.userId)
        && isActiveProfile(request.auth.uid)
        && request.resource.data.requestedRole == 'employee'
        && request.resource.data.status == 'pending'
        && request.resource.data.isDeleted == false
        && hasNoDeletionMetadata()
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null;
      allow update: if isAdmin() && resourceIsActive()
        && doesNotChangeDeletionMetadata();
    }

    // ─── notifications/{id} ─────────────────────────────────────────────
    // Server / admin actions fan out notifications. Users read + dismiss their own.
    match /notifications/{id} {
      allow read: if (isOwner(resource.data.userId)
          && isActiveProfile(request.auth.uid)) || isAdmin();
      allow update: if resourceIsActive() && doesNotChangeDeletionMetadata()
        && request.resource.data.userId == resource.data.userId
        && ((isOwner(resource.data.userId) && isNotificationReadUpdate()) || isAdmin());
      allow delete: if false;
      allow create: if isAdmin() && hasNoDeletionMetadata();
    }

    // ─── app_settings/{id} ──────────────────────────────────────────────
    // Reward amounts and other globals — readable by any signed-in user (the
    // client reads defaults on launch), writable only by admins.
    // reward_settings.employee_cash_bonus is the sole source of the approved
    // task bonus (see configuredTaskBonus in functions/src/admin-finance.ts).
    // Every write must leave it valid, and the document cannot be deleted.
    match /app_settings/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && (id != 'reward_settings'
          || isValidTaskBonus(request.resource.data.get('employee_cash_bonus', null)));
      allow delete: if isAdmin() && id != 'reward_settings';
    }

    // ─── audit_logs/{id} ────────────────────────────────────────────────
    // Admin-only.
    match /audit_logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
